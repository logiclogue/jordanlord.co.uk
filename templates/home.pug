extends default.pug

block content
    .twelve
        canvas.u-full-width.logiclogue-ez-susa-screen(
            width='256',
            height='192',
            data-screen-width='256',
            data-screen-height='192',
            data-susa-background='/res/jordan.png',
            data-susa-text=mission,
            aria-label=mission,
            style={ 'image-rendering': 'pixelated' }
        )= mission
    
    .row.margin-bottom
        .home-icons
            .three.columns
                +iconGithub(github)

            .three.columns
                +icon('https://youtube.com/channel/', youtube, 'youtube')

            .three.columns
                +icon('https://linkedin.com/in/', linkedin, 'linkedin')

            .three.columns
                +icon('https://twitter.com/', twitter, 'twitter')
